# Copy this file to .env and change the values. Never commit .env.

# --- Application ---------------------------------------------------------------
# production | development
APP_ENV=production
# 1 shows detailed error pages (development only)
APP_DEBUG=0
APP_TIMEZONE=Africa/Dar_es_Salaam
# The app opens at http://localhost:8080
APP_PORT=8080

# --- Database (PostgreSQL container) ------------------------------------------
DB_NAME=agizapoa
DB_USER=agizapoa
DB_PASSWORD=change-me-to-a-long-random-password

# Or connect to an external database (e.g. Render) with a single URL instead:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Admin password recovery --------------------------------------------------
# Set a long secret to enable /admin-recovery; leave empty to disable it.
ADMIN_RECOVERY_CODE=

# --- Sessions -------------------------------------------------------------------
# Staff are signed out after this many seconds without activity (0 = never).
ADMIN_IDLE_TIMEOUT=120

# --- Optional -------------------------------------------------------------------
# Database UI: docker compose --profile tools up -d adminer
# ADMINER_PORT=8081
# Host port for PostgreSQL in dev mode
# DB_PORT_HOST=5432
