# Nginx site config. ${PORT} and ${PHP_FPM_HOST} are filled in at container start.
#  - docker-compose: PORT=80,    PHP_FPM_HOST=backend:9000
#  - standalone:     PORT=10000, PHP_FPM_HOST=127.0.0.1:9000

server {
    listen ${PORT} default_server;
    server_name _;

    root /usr/share/nginx/html;
    charset utf-8;
    server_tokens off;
    client_max_body_size 12m;

    access_log /dev/stdout;
    error_log  /dev/stderr warn;

    # Compression for text assets and HTML
    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_vary on;
    gzip_types text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml;

    # Static frontend: served directly by Nginx, cached for a year (URLs carry ?v=<build>).
    location /assets/ {
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff";
        try_files $uri =404;
    }

    location = /robots.txt {
        access_log off;
        try_files $uri =404;
    }

    location = /favicon.ico {
        access_log off;
        log_not_found off;
        return 204;
    }

    # Never serve hidden files
    location ~ /\. {
        deny all;
    }

    # Everything else goes to the PHP front controller
    location / {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/app/public/index.php;
        fastcgi_param SCRIPT_NAME     /index.php;
        fastcgi_param DOCUMENT_ROOT   /var/www/app/public;
        fastcgi_pass ${PHP_FPM_HOST};

        fastcgi_read_timeout 75s;
        fastcgi_buffer_size 32k;
        fastcgi_buffers 16 16k;
    }
}
